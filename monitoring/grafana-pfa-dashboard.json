{
  "dashboard": {
    "id": null,
    "title": "🚀 PFA TaskFlow Pro - Production Dashboard",
    "tags": ["pfa", "production", "taskflow"],
    "style": "dark",
    "timezone": "browser",
    "panels": [
      {
        "id": 1,
        "title": "📊 Status des Services",
        "type": "stat",
        "targets": [
          {
            "expr": "up{job=\"pfa-production\"}",
            "legendFormat": "PFA Backend"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "steps": [
                {"color": "red", "value": 0},
                {"color": "green", "value": 1}
              ]
            },
            "mappings": [
              {"options": {"0": {"text": "🔴 OFFLINE"}}, "type": "value"},
              {"options": {"1": {"text": "🟢 ONLINE"}}, "type": "value"}
            ],
            "unit": "none"
          }
        },
        "gridPos": {"h": 8, "w": 6, "x": 0, "y": 0}
      },
      {
        "id": 2,
        "title": "💾 Usage Mémoire (MB)",
        "type": "stat",
        "targets": [
          {
            "expr": "process_resident_memory_bytes{job=\"pfa-production\"} / 1024 / 1024",
            "legendFormat": "Memory"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "palette-classic"
            },
            "unit": "MB"
          }
        },
        "gridPos": {"h": 8, "w": 6, "x": 6, "y": 0}
      },
      {
        "id": 3,
        "title": "🗄️ MongoDB Connexions",
        "type": "stat",
        "targets": [
          {
            "expr": "mongodb_connections_current{job=\"pfa-production\"}",
            "legendFormat": "Connexions"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "steps": [
                {"color": "red", "value": 0},
                {"color": "yellow", "value": 1},
                {"color": "green", "value": 3}
              ]
            },
            "unit": "short"
          }
        },
        "gridPos": {"h": 8, "w": 6, "x": 12, "y": 0}
      },
      {
        "id": 4,
        "title": "⚡ CPU Usage",
        "type": "stat",
        "targets": [
          {
            "expr": "rate(process_cpu_user_seconds_total{job=\"pfa-production\"}[1m]) * 100",
            "legendFormat": "CPU %"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "steps": [
                {"color": "green", "value": 0},
                {"color": "yellow", "value": 50},
                {"color": "red", "value": 80}
              ]
            },
            "unit": "percent"
          }
        },
        "gridPos": {"h": 8, "w": 6, "x": 18, "y": 0}
      },
      {
        "id": 5,
        "title": "🌐 Requêtes HTTP par minute",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(http_requests_total{job=\"pfa-production\"}[1m]) * 60",
            "legendFormat": "{{method}} {{route}}"
          }
        ],
        "yAxes": [
          {
            "label": "Requêtes/min",
            "min": 0
          }
        ],
        "legend": {
          "show": true,
          "values": false,
          "current": false,
          "max": false,
          "min": false,
          "total": false,
          "avg": false
        },
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8}
      },
      {
        "id": 6,
        "title": "⏱️ Temps de Réponse (ms)",
        "type": "graph",
        "targets": [
          {
            "expr": "http_request_duration_ms{job=\"pfa-production\"}",
            "legendFormat": "{{method}} {{route}}"
          }
        ],
        "yAxes": [
          {
            "label": "Millisecondes",
            "min": 0
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8}
      },
      {
        "id": 7,
        "title": "✅ Tâches par Statut",
        "type": "piechart",
        "targets": [
          {
            "expr": "pfa_tasks_total{job=\"pfa-production\"}",
            "legendFormat": "{{status}}"
          }
        ],
        "options": {
          "pieType": "pie",
          "tooltip": {
            "mode": "single"
          },
          "legend": {
            "displayMode": "visible",
            "placement": "bottom"
          },
          "displayLabels": ["name", "value"]
        },
        "gridPos": {"h": 8, "w": 8, "x": 0, "y": 16}
      },
      {
        "id": 8,
        "title": "📁 Métriques Projets",
        "type": "stat",
        "targets": [
          {
            "expr": "pfa_projects_total{job=\"pfa-production\"}",
            "legendFormat": "Total Projets"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "palette-classic"
            },
            "unit": "short"
          }
        },
        "gridPos": {"h": 8, "w": 8, "x": 8, "y": 16}
      },
      {
        "id": 9,
        "title": "👥 Activité Utilisateurs",
        "type": "graph",
        "targets": [
          {
            "expr": "pfa_user_activity_total{job=\"pfa-production\"}",
            "legendFormat": "{{action}} - {{user_role}}"
          }
        ],
        "yAxes": [
          {
            "label": "Actions",
            "min": 0
          }
        ],
        "gridPos": {"h": 8, "w": 8, "x": 16, "y": 16}
      }
    ],
    "time": {
      "from": "now-30m",
      "to": "now"
    },
    "refresh": "10s",
    "schemaVersion": 30
  }
}